{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enka-admin-v2-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "APP_ENV": "staging",
    "STAGING_MARKER": "REPLACE_WITH_NEW_STAGING_MARKER",
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_STAGING_ACCESS_AUD",
    "PUBLIC_IMAGES_BASE": "",
    "STOREFRONT_BASE": "https://enkaelectronics.com.ge",
    "ALLOW_PRODUCTION_PUBLISH": "false"
  },
  "kv_namespaces": [{ "binding": "CATALOG_KV", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "IMAGES_BUCKET", "bucket_name": "enka-admin-images-staging" }],
  "durable_objects": { "bindings": [{ "name": "CATALOG_WRITER", "class_name": "CatalogWriter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CatalogWriter"] }]
}

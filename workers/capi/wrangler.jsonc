{
  "name": "my-meta-capi",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "SERVER_PURCHASE_ONLY": "true", "GA4_MEASUREMENT_ID": "G-KHQG9C6JQF" },
  "routes": [{ "pattern": "capi.enkaelectronics.com.ge", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "PURCHASE_DELIVERY", "class_name": "PurchaseDelivery" },
      { "name": "GOOGLE_LEAD_DELIVERY", "class_name": "GoogleLeadDelivery" }]
  },
  "migrations": [{ "tag": "purchase-v1", "new_sqlite_classes": ["PurchaseDelivery"] },
    { "tag": "google-lead-v1", "new_sqlite_classes": ["GoogleLeadDelivery"] }]
}
